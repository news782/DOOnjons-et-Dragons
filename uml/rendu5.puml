@startuml
skinparam linetype ortho

left to right direction

'--- Contrôleurs principaux ---
package "Jeu" {
    class Main
    class Jeu
    class Creation
}

'--- Personnages et Entités ---
package "Personnages" {
    abstract class Personnage
    class Joueur
    interface Entite
    Joueur --|> Personnage
    Joueur ..|> Entite
}

'--- Classes & Races ---
package "Types" {
    abstract class Classe
    abstract class Race
    Classe <|-- Clerc
    Classe <|-- Guerrier
    Classe <|-- Magicien
    Classe <|-- Roublard
    Race <|-- Elfe
    Race <|-- Humain
    Race <|-- Nain
    Race <|-- Halfelin
    Joueur --> Classe
    Joueur --> Race
}

'--- Equipements ---
package "Equipements" {
    interface Equipement
    class Gestion
    abstract class Arme
    class ArmeCourante
    class ArmeDeGuerre
    class ArmeDistance
    abstract class Armure
    class ArmureLegere
    class ArmureLourde
    Equipement <|.. Arme
    Equipement <|.. Armure
    Arme <|-- ArmeCourante
    Arme <|-- ArmeDeGuerre
    Arme <|-- ArmeDistance
    Armure <|-- ArmureLegere
    Armure <|-- ArmureLourde
    Joueur --> Equipement
}

'--- Monstres ---
package "Monstres" {
    class Monstre
    Monstre ..|> Entite
    Monstre --> Joueur : attaque
}

'--- Map & Interface ---
package "MapJeu" {
    class Map
    class Case
    interface ContenuCase
    class Barre
    class Obstacle
    Map --> Case
    Case --> ContenuCase
    Joueur ..|> ContenuCase
    Monstre ..|> ContenuCase
    Case --> Equipement
    Case --> Joueur
    Case --> Obstacle
    BarreHaut --> Joueur
}

'--- MaitreDuJeu ---
package "Maitre" {
    class MaitreDuJeu
    MaitreDuJeu --> Monstre
    MaitreDuJeu --> Map
}

'--- Utilitaires ---
package "Utilitaires" {
    class Des
    abstract class Sort
    class ArmeMagique
    class Guerison
    class BoogieWoogie
    Sort <|-- ArmeMagique
    Sort <|-- Guerison
    Sort <|-- BoogieWoogie
    ArmeMagique --> Joueur
    Guerison --> Joueur
    BoogieWoogie --> Map
    Des --> Joueur
    Des --> Monstre
}

'--- Relations principales ---
Main --> Jeu
Main --> Classe
Main --> Race
Main --> MaitreDuJeu
Main --> Map
Main --> Barre
Main --> Des
Main --> Sort

Creation --> Joueur : créer
Creation --> Race
Creation --> Classe

Joueur --> Map
Joueur --> Des
Joueur --> Sort

@enduml